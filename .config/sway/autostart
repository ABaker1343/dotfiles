# sway stuff to set the desktop to start the portal
exec systemctl --user set-environment XDG_CURRENT_DESKTOP=sway
exec systemctl --user import-environment DISPLAY \
                                         SWAYSOCK \
                                         WAYLAND_DISPLAY \
                                         XDG_CURRENT_DESKTOP

exec hash dbus-update-activation-environment 2>/dev/null && \
     dbus-update-activation-environment --systemd DISPLAY \
                                                  SWAYSOCK \
                                                  XDG_CURRENT_DESKTOP=sway \
                                                  WAYLAND_DISPLAY

# exec xdg-desktop-portal-wlr
exec /usr/bin/lxpolkit
exec nm-applet
exec dunst
exec xrandr --output DP-2 --primary
# exec corectrl --minimize-systray
exec blueberry-tray
exec wl-paste --watch cliphist store

exec_always ~/.config/sway/scripts/pretty.sh --restore
exec_always ~/.config/sway/scripts/ChangeKeyboardLayout.sh --prev

exec_always xrandr --output DP-2 --primary
# exec_always ~/.config/sway/scripts/SetPrimaryDisplay.sh
# exec ~/.config/sway/scipts/FullscreenVRR.sh
# exec wlsunset -t 3000 -l 52.0 -L -2.0
# exec flameshot

# Theming
# exec_always gsettings set org.gnome.desktop.interface gtk-theme "Catppuccin-BL-LB-Dark"
exec_always gsettings set org.gnome.desktop.interface gtk-theme "Adwaita"
exec_always gsettings set org.gnome.desktop.interface icon-theme "Adwaita"   # for GTK3 apps
# exec_always gsettings set org.gnome.desktop.interface color-scheme "prefer-dark"   # for GTK4 apps
exec_always gsettings set org.gnome.desktop.interface font-name "0xProto Nerd Font"   # for GTK4 apps
exec_always xdg-mime default thunar.desktop inode/director application

